{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Vellum main window: core events, native file picker, and fullscreen control.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open"
  ]
}
